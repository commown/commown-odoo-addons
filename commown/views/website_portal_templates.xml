<?xml version="1.0" encoding="utf-8" ?>
<odoo>

  <!-- Add information about missing documents on user details -->
  <template id="portal_layout" inherit_id="commown_discuss.portal_layout">

    <xpath expr="//div[@t-if='user_channels']" position="after">
      <div class="mt-4">
        <h4>Documentation - Tutoriels</h4>
        <hr class="mt-2 mb-2" />
        <div class="list-group">
          Retrouvez nos tutoriels et toute la documentation de Commown...
          <a
                        href="https://forum.commown.coop/c/base-connaissances/9"
                        class="list-group-item text-center mt-2"
                    >Base de connaissance Commown</a>
        </div>
      </div>

      <div class="mt-4">
        <h4>Entraide - Communauté</h4>
        <hr class="mt-2 mb-2" />
        <div class="list-group">
          Rejoignez la communauté pour résoudre vos problèmes, échanger des astuces...
          <a
                        href="https://forum.commown.coop/c/entraide/5"
                        class="list-group-item text-center mt-2"
                    >Forum Commown</a>
        </div>
      </div>
      <div class="mt-4" t-if="st_data">
        <hr class="mt-2 mb-2" />
        <p>Pour contacter l'équipe parcourez la section "Vos besoins d'assistance".</p>
      </div>
    </xpath>

  </template>

  <template id="portal_my_details" inherit_id="portal.portal_my_details">

    <!-- Add a warning to users so that they do not reuse someone else's account -->
    <xpath expr="//form" position="before">
      <div class="alert alert-danger">
        For legal reasons, please never use someone else's account.
      </div>
    </xpath>

  </template>

  <template id="portal_my_invoices" inherit_id="account.portal_my_invoices">

    <xpath expr="//a[@t-att-href='invoice.get_portal_url()']" position="attributes">
      <attribute
                name="t-att-href"
            >invoice.get_portal_url(report_type="pdf", download=True)</attribute>
    </xpath>

    <!-- Add a column with the invoice total -->
    <xpath
            expr="//t[@t-call='portal.portal_table']//thead//th[last()]"
            position="before"
        >
      <th class="text-right">Total amount</th>
    </xpath>
    <xpath
            expr="//t[@t-call='portal.portal_table']//tbody//td[last()]"
            position="before"
        >
      <td class="text-right"><span
                    t-esc="-invoice.amount_total if invoice.move_type == 'out_refund' else invoice.amount_total"
                    t-options='{"widget": "monetary", "display_currency": invoice.currency_id}'
                /></td>
    </xpath>

  </template>

  <template
        id="portal_my_invoices_payment"
        inherit_id="account_payment.portal_my_invoices_payment"
    >
    <xpath expr="//t[@t-set='pending_manual_txs']/.." position="attributes">
      <attribute name="t-if">False</attribute>
    </xpath>
  </template>

  <!-- Customize portal section titles -->

  <template id="portal_my_home_sale" inherit_id="sale.portal_my_home_sale">

    <xpath
            expr="//t[@t-call='portal.portal_docs_entry']/t[@t-set='url']/@t-value[contains(., '/my/quotes')]/ancestor::t/t[@t-set='title']"
            position="attributes"
        >
      <attribute name="t-if">False</attribute>
    </xpath>
    <xpath
            expr="//t[@t-call='portal.portal_docs_entry']/t[@t-set='url']/@t-value[contains(., '/my/quotes')]/ancestor::t/t[@t-set='title']"
            position="after"
        >
      <t t-set="title">My quotations</t>
    </xpath>

    <xpath
            expr="//t[@t-call='portal.portal_docs_entry']/t[@t-set='url']/@t-value[contains(., '/my/orders')]/ancestor::t/t[@t-set='title']"
            position="attributes"
        >
      <attribute name="t-if">False</attribute>
    </xpath>
    <xpath
            expr="//t[@t-call='portal.portal_docs_entry']/t[@t-set='url']/@t-value[contains(., '/my/orders')]/ancestor::t/t[@t-set='title']"
            position="after"
        >
      <t t-set="title">My orders</t>
    </xpath>

  </template>

  <template id="portal_my_home_invoice" inherit_id="account.portal_my_home_invoice">

    <xpath
            expr="//t[@t-call='portal.portal_docs_entry']/t[@t-set='url']/@t-value[contains(., '/my/invoices')]/ancestor::t/t[@t-set='title']"
            position="attributes"
        >
      <attribute name="t-if">False</attribute>
    </xpath>
    <xpath
            expr="//t[@t-call='portal.portal_docs_entry']/t[@t-set='url']/@t-value[contains(., '/my/invoices')]/ancestor::t/t[@t-set='title']"
            position="after"
        >
      <t t-set="title">My receipts, invoices and payments</t>
    </xpath>

  </template>

  <!-- Hide contracts on portal -->
  <template id="portal_my_contracts" inherit_id="contract.portal_my_contracts">
    <xpath expr="//t[@t-if='contracts']" position="attributes">
      <attribute name="t-if">False</attribute>
    </xpath>
  </template>

  <template id="portal_contract_page" inherit_id="contract.portal_contract_page">
    <xpath expr="//t[@t-call='portal.portal_record_layout']" position="attributes">
      <attribute name="t-if">False</attribute>
    </xpath>
  </template>
  <!-- End Hide contracts on portal -->

  <template id="portal_my_home" inherit_id="project.portal_my_home">

    <xpath
            expr="//t[@t-call='portal.portal_docs_entry']/t[@t-set='url']/@t-value[contains(., '/my/tasks')]/ancestor::t/t[@t-set='title']"
            position="attributes"
        >
      <attribute name="t-if">False</attribute>
    </xpath>

    <xpath
            expr="//t[@t-call='portal.portal_docs_entry']/t[@t-set='url']/@t-value[contains(., '/my/tasks')]/ancestor::t/t[@t-set='title']"
            position="after"
        >
      <t t-set="title">My interactions with Commown team</t>
    </xpath>

  </template>

  <!-- End Customize portal section titles -->

  <!-- Hide "Manage payment methods" link -->
  <template id="hide_pay_meth_link" inherit_id="payment.pay_meth_link">
    <xpath expr="//a[@href='/my/payment_method']" position="attributes">
      <attribute name="t-if">False</attribute>
    </xpath>
  </template>

</odoo>
