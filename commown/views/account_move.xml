<odoo>

  <record id="view_move_form" model="ir.ui.view">
    <field name="name">account.move.form (module Commown)</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_move_form" />
    <field name="arch" type="xml">
      <xpath
                expr="//field[@name='line_ids']//field[@name='date_maturity']"
                position="attributes"
            >
        <attribute name="invisible" />
      </xpath>
    </field>
  </record>

  <record id="view_account_invoice_filter" model="ir.ui.view">
    <field name="name">account.invoice.select (in commown module)</field>
    <field name="model">account.move</field>
    <field name="inherit_id" ref="account.view_account_invoice_filter" />
    <field name="arch" type="xml">
        <xpath expr="//search" position="inside">
          <field
                    name="line_ids"
                    string="Analytic tags"
                    filter_domain="[('line_ids.analytic_tag_ids','like', self)]"
                />
        </xpath>
    </field>
  </record>

</odoo>
