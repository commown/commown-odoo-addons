<odoo>

  <record id="view_website_form" model="ir.ui.view">
    <field name="name">website.form (in the commown module)</field>
    <field name="model">website</field>
    <field name="inherit_id" ref="website_b2b.view_website_form" />
    <field name="arch" type="xml">

      <xpath expr="//page[@name='custom-features']" position="inside">
        <group>
          <field name="product_service_details_url" />
	</group>
      </xpath>

    </field>
  </record>


</odoo>
