<?xml version="1.0" ?>
<odoo>

  <!-- Server action that retries the payment of an issue -->
  <record id="action_retry_payment" model="ir.actions.server">
    <field name="name">Retry payment</field>
    <field name="model_id" ref="project.model_project_task" />
    <field name="sequence">5</field>
    <field name="state">code</field>
    <field
            name="code"
        >record.with_delay(max_retries=1)._slimpay_payment_issue_retry_payment()</field>
  </record>

  <!-- Server action that sends a warning SMS -->
  <record id="send_payment_warn_sms" model="ir.actions.server">
    <field name="name">Send warning SMS for upcoming payment</field>
    <field name="model_id" ref="project.model_project_task" />
    <field name="sequence">5</field>
    <field name="state">code</field>
    <field name="code">record._slimpay_payment_issue_send_sms()</field>
  </record>

  <!-- Send payment warning SMS when task enters the
       stage_warn_partner_and_wait stage -->
  <record id="set_invoice_next_date_when_entering_warn_stage" model="base.automation">
    <field
            name="name"
        >Set next payment date when entering warn partner and wait stage</field>
    <field name="model_id" ref="project.model_project_task" />
    <field name="sequence">5</field>
    <field name="trigger">on_write</field>
    <field
            name="filter_pre_domain"
            eval="[('stage_id', '!=', ref('stage_warn_partner_and_wait'))]"
        />
    <field
            name="filter_domain"
            eval="[('stage_id', '=', ref('stage_warn_partner_and_wait'))]"
        />
    <field name="action_server_id" eval="ref('send_payment_warn_sms')" />
  </record>

  <!-- Automatic action triggering a payment retrial when an payment issue
       enters the dedicated stage ('stage_retry_payment_and_wait') -->
  <record id="retry_payment" model="base.automation">
    <field name="name">Retry payment when entering the dedicated stage</field>
    <field name="model_id" ref="project.model_project_task" />
    <field name="sequence">5</field>
    <field name="trigger">on_write</field>
    <field
            name="filter_pre_domain"
            eval="[('stage_id', '!=', ref('stage_retry_payment_and_wait'))]"
        />
    <field
            name="filter_domain"
            eval="[('stage_id', '=', ref('stage_retry_payment_and_wait'))]"
        />
    <field name="action_server_id" eval="ref('action_retry_payment')" />
  </record>

</odoo>
