#. module: payment_slimpay_issue
#: model:mail.template,body_html:payment_slimpay_issue.mail_warn_user
msgid ""
"\n"
"\t<div style=\"background:#F0F0F0;color:#515166;padding:10px 0px;font-family:Arial,Helvetica,sans-serif;font-size:14px;\">\n"
"\t<p>\n"
"\t<a href=\"/\"><img src=\"/web/binary/company_logo\" style=\"vertical-align:baseline;max-width:100px;\"></a>\n"
"\t</p>\n"
"\t<br>\n"
"\t<p>Hello,</p>\n"
"\t<br>\n"
"\t<p>Your payment of invoice number <t t-out=\"object.invoice_id.name or '___'\"/> has been\n"
"\trejected<t t-out=\"(object.invoice_unpaid_count or 0) > 1 and ' again' or ''\" />.\n"
"\t</p>\n"
"\t<p>Next attempt will occur in the coming days.\n"
"\tPlease contact us quickly in case you think this new payment could be rejected too,\n"
"\tto avoid bank fees to all parties.\n"
"\t</p>\n"
"\t<br>\n"
"\t<p>Regards,<br>\n"
"\tThe\n"
"\t<a t-att-href=\"object.company_id.website\" style=\"color:#875A7B;\">\n"
"\t<t t-out=\"object.company_id.name\" />\n"
"\t</a>\n"
"\tteam.\n"
"\t</p>\n"
"\t</div>\n"
"\t\n"
"    "
msgstr ""

