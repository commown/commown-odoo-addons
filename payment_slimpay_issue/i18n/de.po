#. module: payment_slimpay_issue
#: model:mail.template,body_html:payment_slimpay_issue.smspro_payment_issue
msgid ""
"<html>\n"
"  <body>\n"
"    <div>\n"
"<t t-if=\"object.invoice_unpaid_count in (0, 1)\">\n"
"<p style=\"margin:0px 0px 9px 0px;font-size:13px;font-family:&quot;Lucida "
"Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">Le prélèvement de "
"votre dernière mensualité a été rejeté =&gt; Infos par mail (pensez à "
"consulter vos spams).</p><p style=\"margin:0px 0px 9px 0px;font-size:13px;"
"font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;"
"\">--</p><p style=\"margin:0px 0px 9px 0px;font-size:13px;font-family:&quot;"
"Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">L'équipe "
"Commown - contact@commown.coop</p>\n"
"</t>\n"
"<t t-else=\"\">\n"
"<p style=\"margin:0px 0px 9px 0px;font-size:13px;font-family:&quot;Lucida "
"Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">RAPPEL : Rejet de "
"prélèvement de mensualité =&gt; Contactez-nous d'urgence svp.</p><p "
"style=\"margin:0px 0px 9px 0px;font-size:13px;font-family:&quot;Lucida "
"Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">--</p><p "
"style=\"margin:0px 0px 9px 0px;font-size:13px;font-family:&quot;Lucida "
"Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">L'équipe Commown - "
"contact@commown.coop</p>\n"
"</t>\n"
"</div>\n"
"  </body>\n"
"</html>\n"
msgstr ""

#. module: payment_slimpay_issue
#: model:mail.template,body_html:payment_slimpay_issue.mail_warn_user
msgid ""
"<html>\n"
"  <body><div style=\"background:#F0F0F0;color:#515166;padding:10px 0px;font-"
"family:Arial,Helvetica,sans-serif;font-size:14px;\">\n"
"  <p>\n"
"    <a href=\"/\"><img src=\"/web/binary/company_logo\" style=\"vertical-"
"align:baseline;max-width:100px;\"/></a>\n"
"  </p>\n"
"  <br/>\n"
"  <p>Hello,</p>\n"
"  <br/>\n"
"  <p>Your payment of invoice number <t t-out=\"object.invoice_id.number\"></"
"t> has been\n"
"    rejected<t t-out=\"object.invoice_unpaid_count != 0 and object."
"invoice_unpaid_count != 1 and &#x27; again&#x27; or &#x27;&#x27;\"></t>.\n"
"  </p>\n"
"  <p>Next attempt will occur in the coming days.\n"
"    Please contact us quickly in case you think this new payment could be "
"rejected too,\n"
"    to avoid bank fees to all parties.\n"
"  </p>\n"
"  <br/>\n"
"  <p>Regards,<br/>\n"
"    The\n"
"    <a t-attf-href=\"{{object.project_id.company_id.website}}\" "
"style=\"color:#875A7B;\">\n"
"      <t t-out=\"object.project_id.company_id.name\"></t>\n"
"    </a>\n"
"    team.\n"
"  </p>\n"
"</div>\n"
"\n"
"    </body>\n"
"</html>\n"
msgstr ""

