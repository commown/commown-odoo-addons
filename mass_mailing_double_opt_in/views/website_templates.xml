<odoo>

  <template id="confirm">
    <t t-set="success" t-value="not err_msg" />
    <t t-if="success" t-set="additional_title">Your subscription was confirmed!</t>
    <t t-else="" t-set="additional_title">Subscription failed</t>

    <t t-call="website.layout">
      <div id="wrap">
        <div class="container">
          <div class="row col-12 text-center">
            <h2 id="newsletter_confirm_title" class="py-2">
              <t t-if="success">Your subscription has been completed!</t>
              <t t-else="">Your subscription has failed...</t>
            </h2>
            <div class="py-4">
              <t t-if="success">
                <p id="newsletter_confirm_success_text">
                  You've just subscribed to the newsletter of <t
                                        t-out="env.company.name"
                                    /> and we thank you for this.
                  You will now receive our latest news on your mail address <b
                                        t-out="email"
                                    />.
                </p>
              </t>
              <t t-else="">
                <p id="newsletter_confirm_failure_text">
                  Your subscription to our newsletter has failed, we invite you to try again.
                </p>
              </t>
            </div>
          </div>
          <!-- Debug information -->
          <div
                        t-if="err_msg and debug"
                        id="debug"
                        class="alert alert-warning"
                        role="alert"
                    >
            <b>Debug error message</b>
            <hr />
            <t t-out="err_msg" />
          </div>
        </div>
      </div>
    </t>
  </template>

</odoo>
