<odoo>

    <record id="automation_send_sponsor_notification_email" model="base.automation">
        <field name="name">[Commown] Send sponsorship notification email</field>
        <field name="model_id" ref="contract.model_contract_contract" />
        <field name="trigger">on_time</field>
        <field
            name="trg_date_id"
            search="[('model', '=', 'contract.contract'), ('name', '=', 'date_start')]"
        />
        <field name="trg_date_range">15</field>
        <field name="trg_date_range_type">day</field>
        <field
            name="filter_domain"
        >['|', ('date_end', '&gt;=', datetime.date.today()), '&amp;', ('date_end', '=', False), ('recurring_next_date', '!=', False)]</field>
        <field name="action_server_id" ref="action_send_sponsor_notification_mail" />
    </record>

</odoo>
