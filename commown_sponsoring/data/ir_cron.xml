<odoo>

    <record id="cron_send_sponsorship_notification_mail" model="ir.cron">
      <field name="name">[Commown] Send sponsor notification emails</field>
      <field name="active" eval="True" />
      <field name="user_id" ref="base.user_root" />
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="doall" eval="False" />
      <field name="model_id" ref="contract.model_contract_contract" />
      <field name="code">model._cron_send_sponsor_notif_emails()</field>
    </record>

</odoo>
