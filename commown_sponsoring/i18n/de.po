#. module: commown_sponsoring
#: model:mail.template,body_html:commown_sponsoring.mail_sponsoring_notify
msgid ""
"<div>\n"
"  <p>Bonjour <t t-out=\"object.firstname\"></t>,</p>\n"
"  <br>\n"
"  <p>\n"
"    Nous vous informons que votre code de parrainage a été utilisé\n"
"    pour une nouvelle location par <t t-out=\"ctx['sponsored'].name\"></"
"t> !\n"
"  </p>\n"
"  <p>Vous bénéficierez d'une réduction sur votre prochaine facture de "
"contrat :)</p>\n"
"  <br>\n"
"  <p>Belle journée !</p>\n"
"  <br>\n"
"  <p>L'équipe Commown.</p>\n"
"</div>\n"
"    "
msgstr ""
"<div>\n"
"  <p>Hallo <t t-out=\"object.firstname\"></t>,</p>\n"
"  <br>\n"
"  <p>\n"
"    Wir möchten Sie darüber informieren, dass Ihr Empfehlungscode\n"
"    für einen neuen Mietvertrag von <t t-out=\"ctx['sponsored'].name\"></t> "
"verwendet wurde!\n"
"  </p>\n"
"  <p>Sie erhalten einen Rabatt auf Ihre nächste Vertragsrechnung :)</p>\n"
"  <br>\n"
"<p> Einen schönen Tag noch!</p>\n"
"  <br>\n"
"<p>Ihr Commown-Team.</p>\n"
"</div>\n"
"    "

