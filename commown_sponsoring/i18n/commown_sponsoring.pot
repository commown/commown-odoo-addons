#. module: commown_sponsoring
#: model:mail.template,body_html:commown_sponsoring.mail_sponsoring_notify
msgid ""
"<t t-set=\"nb_contracts\" t-value=\"len(ctx['sponsored'])\"></t>\n"
"<t t-set=\"plural\" t-value=\"nb_contracts &gt; 1\"></t>\n"
"<div>\n"
"  <p>Bonjour <t t-out=\"object.firstname\"></t>,</p>\n"
"  <br>\n"
"  <p>\n"
"    Nous vous informons que votre code de parrainage a été utilisé pour <b t-if=\"plural\">les <t t-out=\"nb_contracts\"></t> nouveaux contrats suivants</b><b t-else=\"\">le nouveau contrat suivant</b> :\n"
"  </p>\n"
"  <ul>\n"
"    <li t-foreach=\"ctx['sponsored']\" t-as=\"contract\" t-out=\"contract.name\">\n"
"  </ul>\n"
"  <p>\n"
"    Vous bénéficierez d'une réduction <t t-if=\"plural\">pour chacune de ces locations </t>sur vos prochaines mensualités.\n"
"  </p>\n"
"  <br>\n"
"  <p>Bonne journée !</p>\n"
"  <br>\n"
"  <p>L'équipe Commown.</p>\n"
"</div>\n"
"    "
msgstr ""

