<odoo>

    <record model="ir.ui.view" id="view_campaign">
        <field name="name">coupon.campaign.form (in commown_sponsoring)</field>
        <field name="model">coupon.campaign</field>
        <field name="inherit_id" ref="website_sale_coupon.coupon_campaign_form" />
        <field name="arch" type="xml">
            <group name="general" position="inside">
                <field name="sponsor_partner_id" />
            </group>
        </field>
    </record>

    <record model="ir.ui.view" id="view_campaign_search">
        <field name="name">coupon.campaign.search (in commown_sponsoring)</field>
        <field name="model">coupon.campaign</field>
        <field name="arch" type="xml">
            <search>
                <field name="sponsor_partner_ids" />
                <filter
                    string="Sponsorship campaigns"
                    name="sponsorship_campaigns"
                    domain="[('sponsor_partner_ids', '!=', False)]"
                />
            </search>
        </field>
    </record>

</odoo>
