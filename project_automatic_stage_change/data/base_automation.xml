<odoo>

    <record id="passive_stage_change_automation" model="base.automation">
        <field name="name">Change task stage after a given time</field>
        <field name="sequence">1</field>
        <field name="model_id" ref="project.model_project_task" />
        <field name="trigger">on_time</field>
        <field
            name="trg_date_id"
            search="[('model', '=', 'project.task'), ('name', '=', 'timely_stage_change_datetime')]"
        />
        <field name="trg_date_range">0</field>
        <field name="trg_date_range_type">minutes</field>
        <field name="filter_domain">[("has_timely_stage_change", "=", True)]</field>
        <field name="action_server_id" ref="move_task_to_timely_stage_dest_action" />
    </record>

</odoo>
