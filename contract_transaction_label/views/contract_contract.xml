<odoo>

  <record id="contract_contract_form_view" model="ir.ui.view">
    <field name="name">Commown contract</field>
    <field name="model">contract.contract</field>
    <field name="inherit_id" ref="contract_payment_auto.contract_contract_form_view" />
    <field name="arch" type="xml">
      <xpath expr="//group[@name='group_auto_pay']" position="inside">
      <group name="group_transaction">
            <field name="transaction_label" />
      </group>
      </xpath>
    </field>
  </record>

</odoo>
