<odoo>

  <record id="view_lot_form" model="ir.ui.view">
    <field name="name">stock.lot.form (in commown_devices)</field>
    <field name="model">stock.lot</field>
    <field name="inherit_id" ref="stock.view_production_lot_form" />
    <field name="arch" type="xml">

      <field name="ref" position="after">
        <field name="current_location_id" />
      </field>

      <xpath expr="//notebook/page[@name='description']" position="before">
        <page name="history" string="Device history">
          <field name="important_tasks">
            <tree default_order="create_date DESC, id ASC">
              <field name="project_id" widget="many2one_barcode" optional="show" />
              <field name="name" optional="show" />
              <field name="create_date" optional="show" />
              <field
                                name="commercial_partner_id"
                                widget="many2one_barcode"
                                optional="show"
                            />
              <field name="stage_id" optional="show" />
              <field name="tag_ids" widget="many2many_tags" optional="show" />
            </tree>
          </field>
        </page>
      </xpath>

    </field>
  </record>

</odoo>
