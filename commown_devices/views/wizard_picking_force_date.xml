<odoo>

  <record id="force_picking_date_wizard_form" model="ir.ui.view">
    <field name="name">force.picking.date.wizard.form</field>
    <field name="model">force.picking.date.wizard</field>
    <field name="arch" type="xml">
      <form>
        <group>
          <field name="concerned_lot" />
        </group>
        <separator string="Device pickings" />
        <field name="wizard_line_ids" type="xml" nolabel="1">
          <tree editable="top" create="0" delete="0">
            <field name="picking_id" />
            <field name="orig_location" />
            <field name="dest_location" />
          </tree>
        </field>
      </form>
    </field>
  </record>

</odoo>
