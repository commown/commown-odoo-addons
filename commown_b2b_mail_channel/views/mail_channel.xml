<odoo>

  <record model="ir.ui.view" id="view_mail_channel_form">
    <field name="name">mail.channel.form</field>
    <field name="model">mail.channel</field>
    <field name="inherit_id" ref="mail.mail_channel_view_form" />
    <field name="arch" type="xml">
      <field name="description" position="after">
        <field name="partner_companies" invisible="1" />
        <field name="channel_type" invisible="1" />
        <field
                    name="partner_company"
                    options="{'no_create': True, 'open': True}"
                    attrs="{'invisible': ['|', ('public', '!=', 'private'), ('channel_type', '!=', 'channel')]}"
                />
      </field>
    </field>
  </record>

  <record model="ir.ui.view" id="view_mail_channel_tree">
    <field name="name">mail.channel.tree</field>
    <field name="model">mail.channel</field>
    <field name="inherit_id" ref="mail.mail_channel_view_tree" />
    <field name="arch" type="xml">
      <field name="name" position="replace">
        <field name="display_name" />
      </field>
    </field>
  </record>

</odoo>
