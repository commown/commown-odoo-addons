<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

  <template
        id="rating_external_page_submit"
        name="NPS rating page submit"
        inherit_id="rating.rating_external_page_submit"
    >

    <xpath expr="//form[@method='post']/div" position="before">
      <div class="row mt-5">
        <p>Please submit your answer to the question</p>
        <p><i>How likely is it you recommend us to a friend?</i></p>
	<p>(0: Very unlikely, 10: Very likely)</p>
      </div>
    </xpath>

    <xpath expr="//form//img" position="attributes">
      <attribute
                name="t-attf-src"
            >/project_rating_nps/static/src/img/rate_#{rate_name}.png</attribute>
    </xpath>

  </template>

</odoo>
