<odoo>

  <template id="portal_layout" inherit_id="portal.portal_layout">
    <xpath expr="//a[@href='/my/account']/ancestor::div[1]/div[1]" position="after">
      <div class="mt-2">
        <t
                    t-set="is_b2b"
                    t-value="user_id.website_id == env.ref('website_sale_b2b.b2b_website')"
                />
        <t
                    t-set="no_card"
                    t-value="(not user_id.partner_id.id_card1 and not user_id.partner_id.id_card2)"
                />
        <t
                    t-set="no_poa"
                    t-value="(is_b2b and not user_id.partner_id.company_record) or (not is_b2b and not user_id.partner_id.proof_of_address)"
                />
        <i class="fa fa-copy fa-fw" /><span class="ml-2">ID card</span> <i
                    t-attf-class="fa #{no_card and 'fa-exclamation-triangle' or 'fa-check' }"
                    t-attf-style="#{no_card and 'color:red' or ''}"
                />
        <br />
        <i class="fa fa-copy fa-fw" /><span class="ml-2"><t
                        t-if="is_b2b"
                    >Company record</t><t t-else="">Proof of address</t></span> <i
                    t-attf-class="fa #{no_poa and 'fa-exclamation-triangle' or 'fa-check' }"
                    t-attf-style="#{no_poa and 'color:red' or ''}"
                />
      </div>
    </xpath>
    </template>

  <template id="portal_my_details" inherit_id="portal.portal_my_details">

    <!-- Submit form in multipart as it may now contain files -->
    <xpath expr="//form" position="attributes">
      <attribute name="enctype">multipart/form-data</attribute>
    </xpath>

  </template>

  <template id="portal_my_details_fields" inherit_id="portal.portal_my_details_fields">

    <!-- Add ID card and proof of address before address -->
    <xpath expr="//select[@name='country_id']/ancestor::div[1]" position="after">

      <h3 class="col-lg-12">Documents</h3>

      <t
                t-set="is_b2b"
                t-value="user_id.website_id == env.ref('website_sale_b2b.b2b_website')"
            />
      <t
                t-foreach="['id_card1', 'id_card2', 'company_record' if is_b2b else 'proof_of_address']"
                t-as="field"
            >
        <t
                    t-set="label"
                    t-value="partner._fields[field].get_description(env)['string']"
                />
        <div t-attf-class="mb-3 #{error.get(field) and 'has-error' or ''} col-lg-6">
          <label class="col-form-label" t-attf-for="#{field}" t-esc="label" />
          <t t-if="partner[field]">
            <button
                            class="cwn_bin_field_btn pull-right btn btn-sm btn-warning fa fa-trash"
                            title="Trash document"
                            t-attf-data-title-next-click="Undo"
                            t-attf-style="#{absent and 'display:none'}"
                        />
            <button
                            class="cwn_bin_field_btn pull-right btn btn-sm btn-warning fa fa-undo"
                            title="Undo removal"
                            style="display:none"
                        />
          </t>
          <a
                        t-if="partner[field]"
                        download=""
                        class="btn btn-sm btn-info pull-right"
                        t-attf-href="/web/image?model=res.partner&amp;download=true&amp;field=#{field}&amp;id=#{partner.id}"
                    >
             <i title="Download document" class="fa fa-download" />
          </a>
          <input t-if="not partner[field]" type="file" t-attf-name="#{field}" />
          <input t-else="" type="file" t-attf-name="#{field}" disabled="disabled" />
        </div>
      </t>

      <script type="text/javascript">
        $(function() {
          $('button.cwn_bin_field_btn').click(function(ev) {
            ev.preventDefault();
            var $div = $(this).closest('div');
            $div.find('button.cwn_bin_field_btn').toggle();
            $div.find('a[download]').toggle();
            var $input = $div.find('input');
            $input.prop('disabled', !$input.prop('disabled'))
          });
        });
      </script>

    </xpath>

    </template>
</odoo>
