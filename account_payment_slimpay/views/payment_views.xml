<odoo>

  <record id="payment_provider_form" model="ir.ui.view">
    <field name="name">Slimpay Provider Form</field>
    <field name="model">payment.provider</field>
    <field name="inherit_id" ref="payment.payment_provider_form" />
    <field name="arch" type="xml">
      <group name="provider_credentials" position="inside">
        <group attrs="{'invisible': [('code', '!=', 'slimpay')]}">
          <field name="slimpay_api_url" />
          <field name="slimpay_creditor" />
          <field name="slimpay_app_id" />
          <field name="slimpay_app_secret" password="True" />
        </group>
      </group>
    </field>
  </record>

</odoo>
