<odoo noupdate="1">

  <record model="ir.rule" id="contract_contract_netinstaller_user_allow_read">
    <field name="name">
      Netinstaller users must be able to read customer contracts.
    </field>
    <field name="model_id" ref="contract.model_contract_contract" />
    <field name="domain_force" eval="[('contract_type', '=', 'sale')]" />
    <field name="groups" eval="[Command.set([ref('group_netinstaller_user')])]" />
    <field name="perm_read" eval="1" />
    <field name="perm_write" eval="0" />
    <field name="perm_create" eval="0" />
    <field name="perm_unlink" eval="0" />
  </record>

  <record model="ir.rule" id="sale_order_line_netinstaller_user_allow_read">
    <field name="name">
      Netinstaller users must be able to read sale order line (for product_id).
    </field>
    <field name="model_id" ref="sale.model_sale_order_line" />
    <field name="groups" eval="[Command.set([ref('group_netinstaller_user')])]" />
    <field name="perm_read" eval="1" />
    <field name="perm_write" eval="0" />
    <field name="perm_create" eval="0" />
    <field name="perm_unlink" eval="0" />
  </record>

  <record model="ir.rule" id="product_template_netinstaller_user_allow_read">
    <field name="name">
      Netinstaller users must be able to read product templates (for their features).
    </field>
    <field name="model_id" ref="product.model_product_template" />
    <field name="groups" eval="[Command.set([ref('group_netinstaller_user')])]" />
    <field name="perm_read" eval="1" />
    <field name="perm_write" eval="0" />
    <field name="perm_create" eval="0" />
    <field name="perm_unlink" eval="0" />
  </record>

  <record model="ir.rule" id="res_partner_netinstaller_user_allow_read">
    <field name="name">
      Netinstaller users must be able to read partners (for their netinstaller preferences).
    </field>
    <field name="model_id" ref="base.model_res_partner" />
    <field name="groups" eval="[Command.set([ref('group_netinstaller_user')])]" />
    <field name="perm_read" eval="1" />
    <field name="perm_write" eval="0" />
    <field name="perm_create" eval="0" />
    <field name="perm_unlink" eval="0" />
  </record>

</odoo>
