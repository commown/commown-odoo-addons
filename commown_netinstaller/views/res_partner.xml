<odoo>

  <record model="ir.ui.view" id="view_partner_form">
    <field name="name">res.partner.form</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form" />
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">

        <page name="netinstaller" string="Netinstaller">
          <p
                        attrs="{'invisible': ['|', ('is_company', '=', True), ('parent_id', '=', False)]}"
                    >
            Custom Netinstaller post-install scripts can be handled on
            <button
                            name="open_commercial_entity"
                            type="object"
                            string="the parent company"
                            class="oe_link oe_link_product ps-0 ms-1 mb-1"
                        />
          </p>
          <group
                        name="post_install_scripts"
                        attrs="{'invisible': [('is_company', '=', False), ('parent_id', '!=', False)]}"
                    >
            <field name="netinstaller_exec_default_script" />
          </group>
          <separator
                        string="Custom post-install scripts"
                        attrs="{'invisible': [('is_company', '=', False), ('parent_id', '!=', False)]}"
                    />
          <field
                        name="netinstaller_scripts"
                        nolabel="1"
                        attrs="{'invisible': [('is_company', '=', False), ('parent_id', '!=', False)]}"
                    />
        </page>

      </xpath>
    </field>
  </record>

</odoo>
