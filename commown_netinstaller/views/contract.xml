<odoo>

  <record model="ir.ui.view" id="contract_contract_customer_form_view">
    <field name="name">Contract customer form</field>
    <field name="model">contract.contract</field>
    <field name="inherit_id" ref="contract.contract_contract_customer_form_view" />
    <field name="arch" type="xml">

      <xpath expr="//notebook" position="inside">
        <page name="netinstaller" string="Netinstaller">
          <group
                        name="consolidated_feature_values"
                        string="Consolidated feature values"
                    >
            <field
                            name="netinstaller_consolidated_feature_value_ids"
                            nolabel="1"
                            colspan="2"
                        />
          </group>
          <group name="contractual_changes" string="Contractual feature changes">
            <field name="netinstaller_feature_value_change_ids" nolabel="1" colspan="2">
              <tree default_order="date" editable="bottom">
                <field name="date" />
                <field name="feature_value_id" />
              </tree>
            </field>
          </group>
        </page>
      </xpath>

    </field>

  </record>

</odoo>
