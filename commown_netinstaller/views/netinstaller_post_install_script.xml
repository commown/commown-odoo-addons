<odoo>

  <record id="view_post_install_script_tree" model="ir.ui.view">
    <field name="name">view_post_install_script_tree</field>
    <field name="model">commown_netinstaller.post_install_script</field>
    <field name="arch" type="xml">
      <tree editable="bottom">
        <field name="git_clone_url" />
        <field name="git_branch_name" />
        <field name="cmd" />
      </tree>
    </field>
  </record>

  <record id="post_install_scripts_action" model="ir.actions.act_window">
    <field name="name">Netinstaller post install scripts</field>
    <field name="res_model">commown_netinstaller.post_install_script</field>
    <field name="view_mode">tree</field>
    <field name="context">{}</field>
  </record>

  <menuitem
        id="menu_netinstaller_post_install_scripts_action"
        action="commown_netinstaller.post_install_scripts_action"
        parent="menu_netinstaller_settings"
        groups="stock.group_stock_manager"
        sequence="20"
    />

</odoo>
