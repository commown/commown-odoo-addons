<odoo>
  <record model="ir.rule" id="rule_device_assignment_portal">
    <field name="name">Device Assignment: Portal users see only their assignments</field>
    <field name="model_id" ref="model_customer_device_manager_device_assignment"/>
    <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    <field name="domain_force">
        [
            ('partner_id', 'child_of', user.commercial_partner_id.id),
        ]
    </field>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>

  <record model="ir.rule" id="rule_device_assignment_assigner">
    <field name="name">Device Assignment: Device Assigners see only their assignments with the device at customer</field>
    <field name="model_id" ref="model_customer_device_manager_device_assignment"/>
    <field name="groups" eval="[(4, ref('customer_device_manager.group_customer_device_assigner'))]"/>
    <field name="domain_force">
        [
            ('device_location', '=', 'at_customer'),
            ('partner_id', 'child_of', user.commercial_partner_id.id),
        ]
    </field>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>

  </record>

  <record model="ir.rule" id="rule_stock_production_lot_portal">
    <field name="name">Stock Production Lot: Base group portal see only their devices</field>
    <field name="model_id" ref="stock.model_stock_production_lot"/>
    <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    <field name="domain_force">
        [
            ('device_assignment_ids.partner_id', 'child_of', user.commercial_partner_id.id),
        ]
    </field>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>

  <record model="ir.rule" id="rule_contract_portal">
    <field name="name">Contract: Base group portal see only their devices</field>
    <field name="model_id" ref="contract.model_contract_contract"/>
    <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    <field name="domain_force">
        [
            ('lot_ids.device_assignment_ids.partner_id', 'child_of', user.commercial_partner_id.id),
        ]
    </field>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>

  <record model="ir.rule" id="rule_device_assignment_history_portal">
    <field name="name">Device Assignment History: Base group portal read only</field>
    <field name="model_id" ref="model_customer_device_manager_device_assignment_history"/>
    <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
    <field name="domain_force">
        [
            ('assignment_id.partner_id', 'child_of', user.commercial_partner_id.id),
        ]
    </field>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
  </record>

</odoo>
