<odoo>

  <template
        id="my-management-space-portal-access"
        inherit_id="customer_team_manager.my-management-space-portal-access"
    >

    <xpath expr="//div[@id='o_portal_management_space']" position="attributes">
      <attribute
                name="t-if"
                add="or env.user.has_group('customer_device_manager.group_customer_device_assigner')"
                separator=" "
            />
    </xpath>

    <xpath
            expr="//div[@id='o_portal_management_space']//div[hasclass('list-group')]"
            position="inside"
        >
      <a
                class="list-group-item list-group-item-action d-flex align-items-center justify-content-between"
                t-if="env.user.has_group('customer_device_manager.group_customer_device_assigner')"
                t-att-href="'/web#menu_id=%d&amp;action=%d' % (env.ref('customer_manager_base.menu_customer_manager_root').id, env.ref('customer_device_manager.action_device_assignment').id)"
            >
        Devices
        <span
                    t-esc="env['customer_device_manager.device_assignment'].search_count([('device_location', '=', 'at_customer')])"
                    class="badge badge-secondary badge-pill"
                />
      </a>
    </xpath>

  </template>

</odoo>
