<odoo>

  <template id="my-managment-space-portal-access" inherit_id="customer_team_manager.my-managment-space-portal-access">
    <xpath expr="//div[@id='o_portal_managment_space']//div[hasclass('list-group')]" position="inside">
      <a class="list-group-item list-group-item-action d-flex align-items-center justify-content-between"
         t-att-href="'/web#menu_id=%daction_id=%d' % (env.ref('customer_team_manager.menu_customer_team_manager_root').id, env.ref('customer_device_manager.action_device_assignment').id)">
        Devices
        <span t-esc="env['customer_device_manager.device_assignment'].search_count([('device_location', '=', 'at_customer')])"
              class="badge badge-secondary badge-pill"/>
      </a>
    </xpath>
  </template>

</odoo>
