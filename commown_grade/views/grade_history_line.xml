<odoo>

  <record model="ir.ui.view" id="view_grade_history_line_tree">
    <field name="name">grade.history.line.tree</field>
    <field name="model">commown_grade.grade_history_line</field>
    <field name="arch" type="xml">
      <tree editable="bottom">
        <field name="lot_id" />
        <field name="grade_id" />
        <field name="date" />
      </tree>
    </field>
  </record>

  <record id="view_grade_history_line_search" model="ir.ui.view">
    <field name="name">commown_grade.history_line.search</field>
    <field name="model">commown_grade.grade_history_line</field>
    <field name="arch" type="xml">
      <search string="Grade History">
        <field name="lot_id" />
        <field name="product_id" />
        <field name="grade_id" />
        <group expand="0" string="Group By">
          <filter string="Lot name" name="lot" context="{'group_by': 'lot_id'}" />
          <filter
                        string="Product"
                        name="product"
                        context="{'group_by': 'product_id'}"
                    />
          <filter string="Grade" name="grade" context="{'group_by': 'grade_id'}" />
        </group>
      </search>
    </field>
  </record>

  <record id="action_grade_history_line" model="ir.actions.act_window">
    <field name="name">Grade History</field>
    <field name="res_model">commown_grade.grade_history_line</field>
    <field name="type">ir.actions.act_window</field>
    <field name="view_id" ref="view_grade_history_line_tree" />
    <field name="view_mode">tree,graph,pivot</field>
    <field name="search_view_id" ref="view_grade_history_line_search" />
  </record>

  <menuitem
        id="grade_history_line_menu"
        parent="commown_grade.grade_parent_menu"
        action="action_grade_history_line"
        groups="commown_grade.group_manager"
        sequence="20"
    />

</odoo>
