<odoo>

  <record id="view_lot_form" model="ir.ui.view">
    <field name="name">stock.lot.form (in commown_grade)</field>
    <field name="model">stock.production.lot</field>
    <field name="inherit_id" ref="stock.view_production_lot_form"/>
    <field name="arch" type="xml">
      <xpath expr="//group[@name='main_group']/group" position="after">
        <group name="Grade">
          <field name="grade_id" options="{'no_create': True}"/>
          <field name="grade_history_line_ids">
            <tree>
              <field name="grade_id"/>
              <field name="date" options="{'no_edit': True}"/>
            </tree>
          </field>
        </group>
      </xpath>
    </field>
  </record>

</odoo>
