<odoo>

  <template id="my-management-space-portal-access" inherit_id="portal.portal_my_home">
    <xpath expr="//div[hasclass('o_portal_my_home')]//h3" position="before">
      <div
                t-if="env.user.has_group('customer_manager_base.group_customer_admin')"
                id="o_portal_management_space"
                class="mb-4"
            >
        <h3>My managment space</h3>
        <div class="list-group">

          <a
                        class="list-group-item list-group-item-action d-flex align-items-center justify-content-between"
                        t-if="env.user.has_group('customer_manager_base.group_customer_admin')"
                        t-att-href="'/web#menu_id=%daction_id=%d' % (env.ref('customer_manager_base.menu_customer_manager_root').id, env.ref('customer_team_manager.action_customer_users').id)"
                    >
            Users
            <span
                            t-esc="env['res.partner'].search_count([('customer_rank', '>', 0), ('is_company', '=', False), ('type', '=', 'contact'), ('commercial_partner_id.is_company', '=', True)])"
                            class="badge badge-secondary badge-pill"
                        />
          </a>
        </div>
      </div>
    </xpath>
  </template>

</odoo>
