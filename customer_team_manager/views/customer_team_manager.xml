<odoo>

  <record id="view_team_tree" model="ir.ui.view">
    <field name="name">customer_team_manager.team.tree</field>
    <field name="model">customer_team_manager.team</field>
    <field name="arch" type="xml">
      <tree>
        <field name="full_name" />
        <field name="customer_company" />
      </tree>
    </field>
  </record>

  <record id="view_customer_user_kanban" model="ir.ui.view">
    <field name="name">customer_team_manager.customer_user.kanban</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <kanban class="o_res_partner_kanban">
        <field name="id" />
        <field name="name" />
        <field name="email" />
        <field name="phone" />
        <field name="team" />
        <field name="commercial_partner_id" />
        <field name="avatar_128" />
        <field name="portal_status" />
        <field name="customer_roles" />
        <templates>
          <t t-name="kanban-box">
            <div
                            class="oe_kanban_global_click o_kanban_record_has_image_fill o_res_partner_kanban"
                        >

              <t t-if="record.avatar_128.raw_value">
                <div
                                    class="o_kanban_image_fill_left d-none d-md-block"
                                    t-attf-style="background-image:url('#{kanban_image('res.partner', 'avatar_128', record.id.raw_value)}')"
                                >
                </div>
              </t>
              <t t-else="">
                <img
                                    class="o_kanban_image"
                                    alt="Avatar"
                                    t-att-src='_s + "/base/static/img/avatar.png"'
                                />
              </t>

              <div class="oe_kanban_details text-truncate">

                <strong>
                  <span
                                        class="float-right fa fa-user-check"
                                        t-if="record.portal_status.raw_value == 'already_connected'"
                                        t-att-title="record.portal_status.value"
                                    />
                  <span
                                        class="float-right far fa-user"
                                        t-elif="record.portal_status.raw_value == 'never_connected'"
                                        t-att-title="record.portal_status.value"
                                    />
                  <span
                                        class="float-right fa fa-lock"
                                        t-else=""
                                        t-att-title="record.portal_status.value"
                                    />
                  <field name="name" />
                </strong>

                <ul>
                  <li groups="base.group_user">
                    <i class="fa fa-building" title="Company" /> <field
                                            name="commercial_partner_id"
                                        />
                  </li>
                  <li><i class="fa fa-users" title="Team" /> <field name="team" /></li>
                  <li><i class="fa fa-phone" title="Phone" /> <field
                                            t-if="record.phone.raw_value"
                                            name="phone"
                                            widget="phone"
                                        /></li>
                  <li style="text-wrap: nowrap"><i
                                            class="fa fa-envelope"
                                            title="Email"
                                        /> <field name="email" widget="email" /></li>
                  <li><field
                                            name="customer_roles"
                                            widget="customer_role_tag_kanban_widget"
                                        /></li>
                </ul>

              </div>
            </div>
          </t>
        </templates>
      </kanban>
    </field>
  </record>

  <record id="view_customer_user_tree" model="ir.ui.view">
    <field name="name">customer_team_manager.customer_user.tree</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <tree>
        <field name="firstname" />
        <field name="lastname" />
        <field name="email" />
        <field name="phone" />
        <field name="team" />
        <field name="commercial_partner_id" />
        <field name="customer_roles" widget="customer_role_tag_widget" />
        <field name="parent_id" />
        <field name="portal_status" />
      </tree>
    </field>
  </record>

  <record id="view_customer_role_form" model="ir.ui.view">
    <field name="name">customer_team_manager.role.form</field>
    <field name="model">customer_team_manager.customer_role</field>
    <field name="arch" type="xml">
      <form string="User Roles">
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="name" class="oe_inline" />
            </h1>
          </div>
          <group name="main">
            <field name="description" />
            <field name="groups" />
          </group>
          <group name="appareance">
            <field name="color" widget="color" />
            <field name="icon_name" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_customer_user_search" model="ir.ui.view">
    <field name="name">customer_team_manager.customer_user.search</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <search string="Users">
        <field
                    name="name"
                    filter_domain="['|', ('name', 'ilike', self), ('email', 'ilike', self)]"
                />
        <field name="team" />
        <field name="parent_id" />
        <field name="customer_roles" />
        <filter
                    name="inactive"
                    string="Archived users"
                    domain="[('active','=',False)]"
                />
        <group expand="0" string="Group By">
          <filter
                        string="Company"
                        name="parent_id"
                        context="{'group_by': 'parent_id'}"
                    />
          <filter string="Team" name="team" context="{'group_by': 'team'}" />
        </group>
      </search>
    </field>
  </record>

  <record id="view_team_form" model="ir.ui.view">
    <field name="name">customer_team_manager.team.form</field>
    <field name="model">customer_team_manager.team</field>
    <field name="arch" type="xml">
      <form string="Teams">
        <sheet>
          <div class="oe_title">
            <h1>
              <field name="display_name" class="oe_inline" />
            </h1>
          </div>
          <group name="admin" groups="sales_team.group_sale_manager">
            <field name="customer_company" />
          </group>
          <group name="main">
            <field name="name" />
            <field name="parent_team" />
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_customer_user_form" model="ir.ui.view">
    <field name="name">customer_team_manager.customer_user.form</field>
    <field name="model">res.partner</field>
    <field name="arch" type="xml">
      <form string="Users">
        <header>
          <button
                        string="Grant portal access"
                        class="oe_highlight"
                        name="%(action_wizard_portal_access)d"
                        type="action"
                        attrs="{'invisible': ['|', ('portal_status', '!=', 'not_granted'), ('active', '=', False)]}"
                        groups="sales_team.group_sale_manager,customer_manager_base.group_customer_admin"
                    />
          <button
                        string="Revoke portal access"
                        name="action_revoke_portal_access"
                        type="object"
                        attrs="{'invisible': ['|', ('portal_status', '=', 'not_granted'), ('active', '=', False)]}"
                        groups="sales_team.group_sale_manager,customer_manager_base.group_customer_admin"
                    />
          <field name="portal_status" widget="statusbar" />
        </header>
        <sheet>
          <div class="oe_button_box" name="button_box">

            <field name="active" invisible="1" />
            <widget
                            name="web_ribbon"
                            title="Archived"
                            bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"
                        />

          </div>
          <field name="avatar_128" invisible="1" />
          <field
                        name="image_1920"
                        widget='image'
                        class="oe_avatar"
                        options='{"preview_image": "avatar_128"}'
                    />

          <div class="oe_title">
            <h1>
              <field name="display_name" class="oe_inline" />
            </h1>
          </div>
          <div class="alert alert-danger" role="alert">
            For legal reasons, please never reuse an account for someone else.
          </div>
          <group name="admin">
            <field
                            name="parent_id"
                            groups="sales_team.group_sale_manager"
                            domain="[('is_company', '=', True)]"
                        />
            <field
                            name="customer_roles"
                            widget="customer_role_tag_widget"
                            context="{'partner_id': id}"
                        />
          </group>
          <group>
            <group name="main">
              <field name="firstname" />
              <field name="lastname" />
            </group>
            <group name="contact">
              <field
                                name="email"
                                attrs="{'readonly': [('portal_status', '!=', 'not_granted')]}"
                                help="Cannot be modified when the user was granted portal access. Remove the portal access first"
                            />
              <field name="phone" />
            </group>
            <group name="customer_others">
              <field name="commercial_partner_id" invisible="1" />
              <field name="team" />
              <field name="customer_note" />
            </group>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_teams" model="ir.actions.act_window">
    <field name="name">Teams</field>
    <field name="res_model">customer_team_manager.team</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{}</field>
  </record>

  <record id="action_customer_users" model="ir.actions.act_window">
    <field name="name">Users</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">kanban,tree,form</field>
    <field name="context">{'res_partner_search_mode': 'customer'}</field>
    <field
            name="domain"
        >[("customer_rank", "&gt;", 0),("is_company", "=", False), ("commercial_partner_id.is_company", "=", True), '|', ("user_ids", "!=", False), ("type", "in", ["contact", "other"])]</field>
    <field name="search_view_id" ref="view_customer_user_search" />
  </record>

  <record id="action_customer_users_view_kanban" model="ir.actions.act_window.view">
    <field name="sequence" eval="1" />
    <field name="view_mode">kanban</field>
    <field name="view_id" ref="view_customer_user_kanban" />
    <field name="act_window_id" ref="action_customer_users" />
  </record>

  <record id="action_customer_users_view_tree" model="ir.actions.act_window.view">
    <field name="sequence" eval="2" />
    <field name="view_mode">tree</field>
    <field name="view_id" ref="view_customer_user_tree" />
    <field name="act_window_id" ref="action_customer_users" />
  </record>

  <record id="action_customer_users_view_form" model="ir.actions.act_window.view">
    <field name="sequence" eval="2" />
    <field name="view_mode">form</field>
    <field name="view_id" ref="view_customer_user_form" />
    <field name="act_window_id" ref="action_customer_users" />
  </record>

  <record id="action_customer_roles" model="ir.actions.act_window">
    <field name="name">User Roles</field>
    <field name="res_model">customer_team_manager.customer_role</field>
    <field name="view_mode">tree,form</field>
    <field name="context">{}</field>
  </record>

  <menuitem
        id="menu_team"
        action="action_teams"
        sequence="20"
        parent="customer_manager_base.menu_customer_manager_root"
        groups="group_customer_admin,sales_team.group_sale_manager"
    />

  <menuitem
        id="menu_partners"
        action="action_customer_users"
        sequence="10"
        parent="customer_manager_base.menu_customer_manager_root"
        groups="group_customer_admin,sales_team.group_sale_manager"
    />

  <menuitem
        id="menu_role"
        action="action_customer_roles"
        sequence="100"
        parent="customer_manager_base.menu_customer_manager_root"
        groups="sales_team.group_sale_manager"
    />

</odoo>
