<odoo noupdate="1">

  <record model="ir.rule" id="team_customer_rule">
    <field name="name">Customer Team Manager: manage only same Company teams</field>
    <field name="model_id" ref="model_customer_team_manager_team"/>
    <field name="groups" eval="[(4, ref('customer_team_manager.group_customer_admin'))]"/>
    <field name="domain_force">[('customer_company', '=', user.commercial_partner_id.id)]</field>
    <field name="perm_read" eval="True"/>
    <field name="perm_create" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_unlink" eval="True"/>
  </record>

  <record model="ir.rule" id="res_partner_customer_user_rule">
    <field name="name">Customer Team Manager: read/ create/ write only same Company partners</field>
    <field name="model_id" ref="model_res_partner"/>
    <field name="groups" eval="[(4, ref('customer_team_manager.group_customer_admin'))]"/>
    <field name="domain_force">[('id', 'child_of', user.commercial_partner_id.id)]</field>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_create" eval="True"/>
    <field name="perm_unlink" eval="False"/>
  </record>

  <record model="ir.rule" id="ir_exports_rule">
    <field name="name">Customer Team Manager: manage only own exports</field>
    <field name="model_id" ref="base.model_ir_exports"/>
    <field name="groups" eval="[(4, ref('customer_team_manager.group_customer_admin'))]"/>
    <field name="domain_force">[('create_uid','=', user.id)]</field>
    <field name="perm_read" eval="True"/>
    <field name="perm_create" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_unlink" eval="True"/>
  </record>

  <record model="ir.rule" id="ir_exports_line_rule">
    <field name="name">Customer Team Manager: see manage own export lines</field>
    <field name="model_id" ref="base.model_ir_exports_line"/>
    <field name="groups" eval="[(4, ref('customer_team_manager.group_customer_admin'))]"/>
    <field name="domain_force">[('create_uid','=', user.id)]</field>
    <field name="perm_read" eval="True"/>
    <field name="perm_create" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_unlink" eval="True"/>
  </record>

  <record model="ir.rule" id="base_import_mapping_rule">
    <field name="name">Customer Team Manager: manage only own import mappings</field>
    <field name="model_id" ref="base_import.model_base_import_mapping"/>
    <field name="groups" eval="[(4, ref('customer_team_manager.group_customer_admin'))]"/>
    <field name="domain_force">[('create_uid','=', user.id)]</field>
    <field name="perm_read" eval="True"/>
    <field name="perm_create" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_unlink" eval="True"/>
  </record>

</odoo>
