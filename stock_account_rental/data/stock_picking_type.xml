<odoo>

  <data noupdate="1">

    <record id="in_sequence_rental" model="ir.sequence">
      <field name="name">Rental sequence in</field>
      <field name="implementation">standard</field>
      <field name="prefix">WH/IN_RENTAL</field>
    </record>

    <record id="out_sequence_rental" model="ir.sequence">
      <field name="name">Rental sequence in</field>
      <field name="implementation">standard</field>
      <field name="prefix">WH/IN_RENTAL</field>
    </record>

    <record id="stock_picking_type_in_rental" model="stock.picking.type">
      <field name="name">Receipts - Rental</field>
      <field name="code">incoming</field>
      <field name="use_create_lots" eval="True"/>
      <field name="use_existing_lots" eval="False"/>
      <field name="default_location_src_id" eval="False"/>
      <field name="default_location_dest_id" ref="stock_location_rental"/>
      <field name="sequence">100</field>
      <field name="barcode">WH-RECEIPTS-RENTAL</field>
      <field name="sequence_id" ref="in_sequence_rental"/>
    </record>

    <record id="stock_picking_type_out_rental" model="stock.picking.type">
      <field name="name">Delivery Orders - Rental</field>
      <field name="code">outgoing</field>
      <field name="use_create_lots" eval="False"/>
      <field name="use_existing_lots" eval="True"/>
      <field name="default_location_dest_id" eval="False"/>
      <field name="sequence">110</field>
      <field name="barcode">WH-DELIVERY-RENTAL</field>
      <field name="sequence_id" ref="out_sequence_rental"/>
    </record>

  </data>

</odoo>
