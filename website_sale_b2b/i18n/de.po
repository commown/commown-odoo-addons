"\n"
"\n"
"<br/>\n"
"\n"
"\n"
"  <p style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;margin:0px 0px 9px 0px;\"/><p style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;margin:0px 0px 9px 0px;\">Vielen Dank und bis bald,</p>\n"
"\n"
"</div>\n"
"\n"
"</t>\n"
"<t t-else=\"\">\n"
"<p style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;margin:0px 0px 9px 0px;\"><t t-out=\"object.partner_id.firstname\"></t>,</p>\n"
"<p style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;margin:0px 0px 9px 0px;\">Wir danken Ihnen für die Erteilung eines SEPA-Lastschriftenmandats.</p>\n"
