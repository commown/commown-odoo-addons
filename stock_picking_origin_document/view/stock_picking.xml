<odoo>

  <record model="ir.ui.view" id="view_picking_form">
    <field name="name">stock.picking form (stock_picking_origin_document module)</field>
    <field name="model">stock.picking</field>
    <field name="inherit_id" ref="stock.view_picking_form" />
    <field name="arch" type="xml">

      <div name="button_box" position="inside">
        <field name="origin_document_id" invisible="1" />
        <button
                    name="action_open_origin_document"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file"
                    attrs="{'invisible': [('origin_document_model_name', '=', False)]}"
                >
          <div class="o_form_field o_stat_info">
            <span class="o_stat_info o_stat_value"><field
                                name="origin_document_name"
                            /></span>
            <span class="o_stat_text"><field name="origin_document_model_name" /></span>
          </div>
        </button>
      </div>

    </field>
  </record>

</odoo>
